{
  "expo": {
    "name": "ZELO",
    "slug": "zelo-2-0",
    "version": "1.0.0",
    "scheme": "zelo",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/branding/zelo-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/zelo-adaptive-foreground.png",
        "backgroundColor": "#25005F"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.zelo20"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/zelo-wordmark-tagline.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "./plugins/withCmakeObjectPath"
    ]
  }
}
